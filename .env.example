NODE_ENV=development
HOST=0.0.0.0
PORT=666
PUBLIC_ORIGIN=http://127.0.0.1:666
# Local development uses PGlite when DATABASE_URL is omitted.
# DATABASE_URL=postgres://settlement:change-me@127.0.0.1:5432/settlement
# Local development uses an in-process limiter when REDIS_URL is omitted.
# Production requires a private rediss:// Tair endpoint and the fixed production prefix.
# REDIS_URL=redis://127.0.0.1:6379/0
REDIS_KEY_PREFIX=siyan-settlement:development:
REDIS_CONNECT_TIMEOUT_MS=5000
PGLITE_DATA_DIR=.pglite
SESSION_TTL_HOURS=168
BODY_LIMIT_BYTES=1048576
LOGIN_RATE_LIMIT_MAX=5
SMS_ENABLED=false
SMS_CODE_TTL_SECONDS=300
SMS_RESEND_COOLDOWN_SECONDS=60
SMS_VERIFY_MAX_ATTEMPTS=5
SMS_SEND_RATE_LIMIT_MAX=5
SMS_SEND_RATE_LIMIT_IP_MAX=20
SMS_SEND_RATE_LIMIT_WINDOW_SECONDS=3600
# Real SMS requires a separate random HMAC key, an approved Aliyun sign/template,
# and an ECS RAM role. Never put long-lived AccessKey credentials in this file.
# SMS_CODE_HMAC_KEY=
# ALIYUN_SMS_REGION_ID=cn-hangzhou
# ALIYUN_SMS_ENDPOINT=dysmsapi.aliyuncs.com
# ALIYUN_SMS_SIGN_NAME=
# ALIYUN_SMS_LOGIN_TEMPLATE_CODE=
SEED_DEMO=false

# The reminder worker uses PostgreSQL outbox leases. Keep the fake provider for
# local tests only; production rejects it and also requires RELEASE_ID to be a Git SHA.
# The lease must cover batch size * 15 seconds plus a 30-second shutdown margin.
NOTIFICATION_PROVIDER=fake
NOTIFICATION_WORKER_NAME=settlement-reminders
NOTIFICATION_POLL_INTERVAL_MS=5000
NOTIFICATION_BATCH_SIZE=5
NOTIFICATION_LEASE_SECONDS=120
NOTIFICATION_MAX_ATTEMPTS=5
RELEASE_ID=development
# ALIYUN_SMS_DIGEST_TEMPLATE_CODE=

# One-time owner provisioning. Supply the password through a secret manager or
# an interactive shell; do not commit it to this file.
# PROVISION_TENANT_NAME=
# PROVISION_TENANT_TIMEZONE=Asia/Shanghai
# PROVISION_OWNER_PHONE=
# PROVISION_OWNER_NAME=
# PROVISION_OWNER_PASSWORD=

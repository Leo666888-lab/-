NODE_ENV=development
HOST=0.0.0.0
PORT=666
PUBLIC_ORIGIN=http://127.0.0.1:666
# Local development uses PGlite when DATABASE_URL is omitted.
# DATABASE_URL=postgres://settlement:change-me@127.0.0.1:5432/settlement
PGLITE_DATA_DIR=.pglite
SESSION_TTL_HOURS=168
BODY_LIMIT_BYTES=1048576
LOGIN_RATE_LIMIT_MAX=5
SEED_DEMO=false

# One-time owner provisioning. Supply the password through a secret manager or
# an interactive shell; do not commit it to this file.
# PROVISION_TENANT_NAME=
# PROVISION_TENANT_TIMEZONE=Asia/Shanghai
# PROVISION_OWNER_PHONE=
# PROVISION_OWNER_NAME=
# PROVISION_OWNER_PASSWORD=

[Unit]
Description=Encrypted PostgreSQL backup for Siyan Settlement 666
Wants=network-online.target
After=network-online.target
RequiresMountsFor=/var/backups/siyan-settlement-666
OnFailure=siyan-settlement-666-alert@%n.service

[Service]
Type=oneshot
User=siyan-settlement-666-backup
Group=siyan-settlement-666-backup
SupplementaryGroups=siyan-settlement-666-release
WorkingDirectory=/var/backups/siyan-settlement-666
EnvironmentFile=/etc/siyan-settlement-666/backup/backup.env
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin

ExecStartPre=/usr/bin/test -r /etc/siyan-settlement-666/backup/backup.env
ExecStartPre=/usr/bin/test -r /etc/siyan-settlement-666/backup/backup.age-recipient
ExecStartPre=/usr/bin/test -r /etc/siyan-settlement-666/backup/rclone.conf
ExecStartPre=/usr/bin/test -w /var/backups/siyan-settlement-666
ExecStart=/usr/bin/bash /opt/siyan-settlement-666/current/deploy/scripts/siyan-settlement-666-postgres-backup.sh

TimeoutStartSec=2h
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
UMask=0077
StateDirectory=siyan-settlement-666-backup
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
PrivateMounts=true
ProtectSystem=strict
ProtectHome=true
ProtectHostname=true
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
KeyringMode=private
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
RemoveIPC=true
ReadOnlyPaths=/etc/siyan-settlement-666/backup /opt/siyan-settlement-666/current
ReadWritePaths=/var/backups/siyan-settlement-666 /var/lib/siyan-settlement-666-backup
InaccessiblePaths=/etc/siyan-settlement-666/app /etc/siyan-settlement-666/monitor /var/lib/siyan-settlement-666

StandardOutput=journal
StandardError=journal
SyslogIdentifier=siyan-settlement-666-postgres-backup

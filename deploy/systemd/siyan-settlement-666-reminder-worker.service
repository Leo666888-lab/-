[Unit]
Description=Siyan Settlement 666 reminder delivery worker
Wants=network-online.target
After=network-online.target siyan-settlement-666.service
OnFailure=siyan-settlement-666-alert@%n.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=siyan-settlement-666
Group=siyan-settlement-666
SupplementaryGroups=siyan-settlement-666-release
WorkingDirectory=/opt/siyan-settlement-666/current
EnvironmentFile=/etc/siyan-settlement-666/app/app.env

ExecStartPre=/usr/bin/bash -c '[[ -r /etc/siyan-settlement-666/app/app.env ]]'
ExecStartPre=/usr/bin/bash -c '[[ -r /opt/siyan-settlement-666/current/dist/src/worker.js ]]'
ExecStartPre=/usr/bin/bash -c '[[ -x /opt/siyan-settlement-666/runtime/node/bin/node ]]'
ExecStart=/usr/bin/env NODE_ENV=production SEED_DEMO=false /opt/siyan-settlement-666/runtime/node/bin/node /opt/siyan-settlement-666/current/dist/src/worker.js

Restart=on-failure
RestartSec=5s
TimeoutStartSec=60s
TimeoutStopSec=30s
KillSignal=SIGTERM

StateDirectory=siyan-settlement-666
StateDirectoryMode=0750
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
PrivateMounts=true
ProtectSystem=strict
ProtectHome=true
ProtectHostname=true
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
KeyringMode=private
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
RemoveIPC=true
ReadWritePaths=/var/lib/siyan-settlement-666
ReadOnlyPaths=/etc/siyan-settlement-666/app /opt/siyan-settlement-666/current
InaccessiblePaths=/etc/siyan-settlement-666/backup /etc/siyan-settlement-666/monitor /var/backups/siyan-settlement-666
LimitNOFILE=65536
TasksMax=256

StandardOutput=journal
StandardError=journal
SyslogIdentifier=siyan-settlement-666-reminder-worker

[Install]
WantedBy=multi-user.target
